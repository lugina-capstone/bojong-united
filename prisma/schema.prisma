generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

/// Peran di dalam organisasi. Guru dan Asesor memiliki akses yang sama, tetapi labelnya berbeda.
/// User tanpa membership adalah Peserta.
enum MemberRole {
  GURU
  ASESOR
  TRAINER
  ADMIN_ORGANISASI
}

model User {
  id              String      @id @default(cuid())
  /// Wajib huruf kecil (CHECK users_email_lowercase). Satu email untuk satu akun.
  email           String      @unique
  name            String
  emailVerified   Boolean     @default(false)
  image           String?
  /// Administrator platform (global), bukan peran organisasi.
  isAdministrator Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  membership      Membership?
  sessions        Session[]
  accounts        Account[]
  files           File[]

  @@map("users")
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  /// Kode untuk bergabung ke organisasi.
  code      String             @unique
  status    OrganizationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  members   Membership[]

  @@map("organizations")
}

/// Satu user hanya bisa menjadi anggota satu organisasi.
model Membership {
  id             String       @id @default(cuid())
  userId         String       @unique
  organizationId String
  role           MemberRole
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("memberships")
}

// Tabel Better Auth. Nama field mengikuti skema bawaan Better Auth.

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Satu baris per metode login: providerId "credential" (email + password) atau "google".
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash password (scrypt) untuk providerId "credential".
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Token verifikasi email dan reset password.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum FileStatus {
  /// URL upload sudah dibuat, file belum dikonfirmasi ada di storage.
  PENDING
  UPLOADED
}

/// Metadata file di object storage. Isi file tidak pernah disimpan di PostgreSQL.
model File {
  id          String     @id @default(cuid())
  /// Key objek di bucket.
  key         String     @unique
  /// Nama file asli dari user, hanya untuk ditampilkan dan saat diunduh.
  name        String
  contentType String
  /// Ukuran dalam byte (maks 10 MB).
  size        Int
  status      FileStatus @default(PENDING)
  ownerId     String
  uploadedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("files")
}

/// Aplikasi lain (FOMO, COMMIT) yang mengakses /api/v1 dengan API key.
model ApiClient {
  id         String         @id @default(cuid())
  name       String         @unique
  /// Awal API key (mis. "bu_AbCd1234") untuk mengenali key tanpa menyimpan key aslinya.
  keyPrefix  String
  /// SHA-256 dari API key.
  keyHash    String         @unique
  scopes     String[]
  /// Batas request per menit.
  rateLimit  Int            @default(60)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  rateLimits ApiRateLimit[]

  @@map("api_clients")
}

/// Jumlah request per API client per jendela satu menit.
model ApiRateLimit {
  clientId    String
  windowStart DateTime
  count       Int       @default(0)
  client      ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, windowStart])
  @@map("api_rate_limits")
}
