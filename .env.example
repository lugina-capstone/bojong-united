# Salin ke .env lalu sesuaikan. Nilai di bawah cocok dengan compose.yaml untuk development lokal.

# PostgreSQL
DATABASE_URL="postgresql://bojong:bojong@localhost:5432/bojong_united?schema=public"

# Better Auth. Production: buat secret baru dengan `openssl rand -base64 32`.
BETTER_AUTH_SECRET="dev-only-secret-ganti-di-production-0000"
BETTER_AUTH_URL="http://localhost:3000"

# Login Google (opsional di lokal). Buat OAuth client di Google Cloud Console dengan
# redirect URI http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Akun Administrator pertama, dibuat oleh `npm run db:seed`.
ADMIN_EMAIL="admin@localhost.test"
ADMIN_PASSWORD="admin12345"
ADMIN_NAME="Administrator"

# Object storage (S3-compatible). Lokal: SeaweedFS. Production: Cloudflare R2 atau S3.
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_BUCKET="bojong-united"
S3_ACCESS_KEY_ID="bojong"
S3_SECRET_ACCESS_KEY="bojong-local-secret"

# Email (SMTP). Lokal: Mailpit, inbox di http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Bojong United <no-reply@localhost>"
